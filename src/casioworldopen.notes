# ======================================================================
# DOS SPRITES DE FONDO FIJOS EN 0xA926/0xA979 (0xA875, la rutina que
# arranca 0x5AFD antes de la tabla de animacion del golfista)
# ======================================================================
# 0xA875 limpia el buffer 0xE800-0xE9FF y elige, segun el tipo de terreno
# que le llega en A por la pila (2,4,5,7,9,0xc,0xd = uno; el resto = otro),
# entre DOS sprites fijos de fondo (0xA926 o 0xA979), los descomprime con
# 0xA8CB/0xA8FB, y ADEMAS descomprime siempre el sprite de terreno que
# corresponda de tabla_vistas_de_terreno (0xA9EC). Los dos decodifican exacto:
# 0xA926 para justo en 0xA979 (el segundo), y 0xA979 para justo en 0xA9EC
# (el inicio de tabla_vistas_de_terreno, ya declarada) -tila sin hueco con una
# estructura ya conocida, cierra el hueco entero de 198 bytes-.
D 0xa926 0xa979 paleta_de_tiles_a  Sprite de fondo comprimido con el formato de 0xA8FB, decodificado y verificado en Python (83 bytes fuente, 129 de salida)
F 0xa926 16
D 0xa979 0xa9ec paleta_de_tiles_b  Sprite de fondo comprimido con el formato de 0xA8FB, decodificado y verificado en Python (115 bytes fuente, 153 de salida)
F 0xa979 16

# ======================================================================
# TABLA DE 18 PUNTEROS EN 0xACB7 (llamada desde 0x5DEC con indice
# (0xE0B4)-1), DIEZ SPRITES, Y UN BLOQUE FIJO EN 0xB349
# ======================================================================
# 0x5DEC indexa 0xACB7+((0xE0B4)-1)*2 y descomprime con 0xA8FB en 0xEA14;
# el puntero 0-esimo cae justo al terminar la tabla (0xACDB), la misma
# prueba de tila de siempre. De los 18 punteros solo hay 10 direcciones
# unicas y TILAN SIN HUECO, las 9 primeras exactas contra la siguiente y
# la ultima (0xB2A3) para justo en 0xB349 -que es DIRECTAMENTE el HL con
# el que 0x5DEC llama a 0xA8CB justo antes (0x5DEC-0x5DF2), asi que ese
# bloque fijo tambien es un sprite comprimido mas, y decodifica limpio.
D 0xacb7 0xacdb tabla_planos_de_hoyo  18 punteros de 16 bits a sprites, indexados por (0xE0B4)-1 desde 0x5DEC (0x5DFB)
F 0xacb7 w6

D 0xacdb 0xad7b plano_hoyo_01  Sprite comprimido con el formato de 0xA8FB, decodificado y verificado en Python (160 bytes fuente, 190 de salida)
F 0xacdb 16
